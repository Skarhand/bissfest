<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="widget_background">#FFFFFF</color>
    <color name="widget_text">#17201B</color>
    <color name="widget_muted">#66736B</color>
    <color name="widget_track">#E2E7E4</color>
    <color name="widget_accent">#2E8B5F</color>
    <color name="widget_button">#E2F1E8</color>

    <style name="WidgetButton">
        <item name="android:background">@drawable/widget_button</item>
        <item name="android:gravity">center</item>
