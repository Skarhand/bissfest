# SMTP-Zugang für die Bestätigungsmails bei der Registrierung.
# Als ".env" neben die docker-compose.yml legen (chmod 600) und danach: docker compose up -d
# Solange SMTP_HOST leer ist, ist die Registrierung neuer Konten automatisch gesperrt.

SMTP_HOST=
# 587 = STARTTLS (Standard), 465 = SSL
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Absenderadresse (muss zum Postfach passen) und Anzeigename
SMTP_FROM=
SMTP_FROM_NAME=Bissfest

# Eigener Schlüssel für die USDA-Suche, kostenlos unter https://fdc.nal.usda.gov/api-key-signup
# Ohne Eintrag gilt DEMO_KEY, damit sind nur wenige Suchen pro Stunde möglich.
#FDC_API_KEY=
